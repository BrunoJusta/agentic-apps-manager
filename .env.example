# Configuração Firebase (é pública por desenho; a segurança vem das regras do Firestore).
# Se não definires estas variáveis, a app usa os valores do projeto sogrape-ai-studio.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=agentic-apps-prod

# Tenant Microsoft Entra da Sogrape (ID do diretório). Restringe o ecrã de login à Sogrape.
VITE_MS_TENANT_ID=

# Admin de arranque (tem de coincidir com o email nas firestore.rules)
VITE_BOOTSTRAP_ADMIN=bruno.justa@sogrape.pt
